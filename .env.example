# ===================================================================
# MediShare - Environment Configuration Template
# NOTE: Copy this file to .env for local development and fill in real values.
# NEVER commit the actual .env file containing secrets to version control!
# ===================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=medishare_db

# Authentication / Security
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# File Upload / Storage Configuration
# Options: 'local' (development) or 's3' (production)
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=25

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

