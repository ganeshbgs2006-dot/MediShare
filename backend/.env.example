# ===================================================================
# MediShare Backend Environment Configuration Template
# NOTE: Copy this file to .env and configure your MySQL credentials.
# NEVER commit the real .env file with secrets to Git.
# ===================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=medishare

# JWT Authentication
JWT_SECRET=medishare_super_secure_jwt_secret_change_me_in_production_32chars!
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173
